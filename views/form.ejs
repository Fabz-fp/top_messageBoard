<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>

    <form method="POST" action="/new">
      <div>
        <label for="author">Your name:</label>
        <input
          type="text"
          id="author"
          name="author"
          required
        />
      </div>

      <div>
        <label for="messageText">Your message:</label>
        <textarea
          id="messageText"
          name="messageText"
          required
        ></textarea>
      </div>

      <button type="submit">Send Message</button>
    </form>

    <p><a href="/">Back to the message board</a></p>
  </body>
</html>