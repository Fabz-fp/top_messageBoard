<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css" />
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>

    <% if (errors.length > 0) { %>
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    <% } %>

    <form method="POST" action="/new">
      <div>
        <label for="author">Your name:</label>
        <input
          type="text"
          id="author"
          name="author"
          value="<%= formData.author %>"
          maxlength="255"
          required
        />
      </div>

      <div>
        <label for="messageText">Your message:</label>
        <textarea
          id="messageText"
          name="messageText"
          maxlength="5000"
          required
        ><%= formData.messageText %></textarea>
      </div>

      <button type="submit">Send Message</button>
    </form>

    <p><a href="/">Back to the message board</a></p>
  </body>
</html>